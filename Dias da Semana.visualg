algoritmo "dia_semana"

var
   numero: inteiro

inicio

   enquanto numero < 1 ou numero > 7 faca
      escreva("Digite um número de 1 a 7: ")
      leia(numero)
   fimenquanto

   escolha numero
      caso 1
         escreva("Domingo")
      caso 2
         escreva("Segunda-feira")
      caso 3
         escreva("Terça-feira")
      caso 4
         escreva("Quarta-feira")
      caso 5
         escreva("Quinta-feira")
      caso 6
         escreva("Sexta-feira")
      caso 7
         escreva("Sábado")
   fimescolha

fimalgoritmo