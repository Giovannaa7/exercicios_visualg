algoritmo "tabuada"

var
   numero, contador: inteiro

inicio

   enquanto numero < 1 ou numero > 10 faca
      escreva("Digite um número de 1 a 10: ")
      leia(numero)
   fimenquanto

   para contador de 1 ate 10 faca
      escreva(numero, " x ", contador, " = ", numero * contador)
   fimpara

fimalgoritmo
